{
  "$comment": "Generated by schemas/generate.py from architecture baseline 1.4 Ch11/12/16. Authority domains have independent exact discriminators. Unknown properties fail closed. S0 supports no requiredFeatures and provides no boot, signature, image, or execution proof.",
  "$defs": {
    "AsciiId": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9.-]*$(?![\\s\\S])",
      "type": "string"
    },
    "BootRecord": {
      "$comment": "Complete Ch12 boot fields. Extra mounts use persistent selectors; firmware initrdFiles are canonical absolute paths inside firmware.dir. Modules load order is semantically ordered. Boot metadata is schema-only: lexical paths and synthetic sizes/hashes prove no stored object, signature, or bootability.",
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "not": {
              "required": [
                "uki"
              ]
            }
          },
          "if": {
            "properties": {
              "publisher": {
                "properties": {
                  "type": {
                    "const": "uki"
                  }
                },
                "required": [
                  "type"
                ]
              }
            },
            "required": [
              "publisher"
            ]
          },
          "then": {
            "required": [
              "uki"
            ]
          }
        }
      ],
      "properties": {
        "cmdline": {
          "$ref": "#/$defs/Cmdline"
        },
        "firmware": {
          "additionalProperties": false,
          "properties": {
            "dir": {
              "$ref": "#/$defs/StoreFile"
            },
            "initrdFiles": {
              "$comment": "Set-like array: semantic validation additionally requires ascending ASCII key order and unique identity keys.",
              "items": {
                "$ref": "#/$defs/Path"
              },
              "maxItems": 4096,
              "minItems": 0,
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "dir",
            "initrdFiles"
          ],
          "type": "object"
        },
        "health": {
          "$ref": "#/$defs/Health"
        },
        "init": {
          "additionalProperties": false,
          "properties": {
            "adapterBuildId": {
              "$ref": "#/$defs/Digest"
            },
            "adapterId": {
              "$ref": "#/$defs/AsciiId"
            },
            "elfMachine": {
              "enum": [
                62,
                183
              ]
            },
            "path": {
              "$ref": "#/$defs/StoreFile"
            },
            "sha256": {
              "$ref": "#/$defs/Digest"
            }
          },
          "required": [
            "path",
            "sha256",
            "elfMachine",
            "adapterId",
            "adapterBuildId"
          ],
          "type": "object"
        },
        "initrd": {
          "additionalProperties": false,
          "properties": {
            "buildId": {
              "$ref": "#/$defs/Digest"
            },
            "parts": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "role": {
                    "enum": [
                      "microcode",
                      "main",
                      "extra"
                    ]
                  },
                  "sha256": {
                    "$ref": "#/$defs/Digest"
                  },
                  "size": {
                    "$ref": "#/$defs/U64"
                  },
                  "store": {
                    "$ref": "#/$defs/StoreFile"
                  }
                },
                "required": [
                  "role",
                  "store",
                  "sha256",
                  "size"
                ],
                "type": "object"
              },
              "maxItems": 64,
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "parts",
            "buildId"
          ],
          "type": "object"
        },
        "kernel": {
          "additionalProperties": false,
          "properties": {
            "cmdlineLimit": {
              "maximum": 4096,
              "minimum": 256,
              "type": "integer"
            },
            "sha256": {
              "$ref": "#/$defs/Digest"
            },
            "size": {
              "$ref": "#/$defs/U64"
            },
            "store": {
              "$ref": "#/$defs/StoreFile"
            },
            "uname": {
              "$ref": "#/$defs/KernelRelease"
            }
          },
          "required": [
            "store",
            "sha256",
            "size",
            "uname",
            "cmdlineLimit"
          ],
          "type": "object"
        },
        "modules": {
          "additionalProperties": false,
          "properties": {
            "dir": {
              "$ref": "#/$defs/StoreFile"
            },
            "initrdOrder": {
              "items": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$(?![\\s\\S])",
                "type": "string"
              },
              "maxItems": 1024,
              "minItems": 0,
              "type": "array"
            },
            "uname": {
              "$ref": "#/$defs/KernelRelease"
            }
          },
          "required": [
            "dir",
            "uname",
            "initrdOrder"
          ],
          "type": "object"
        },
        "mounts": {
          "$comment": "Set-like array: semantic validation additionally requires ascending ASCII key order and unique identity keys.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "fstype": {
                "$ref": "#/$defs/FsType"
              },
              "mountFlags": {
                "$ref": "#/$defs/MountFlags"
              },
              "source": {
                "$ref": "#/$defs/RootSelector"
              },
              "target": {
                "$ref": "#/$defs/Path"
              }
            },
            "required": [
              "source",
              "target",
              "fstype",
              "mountFlags"
            ],
            "type": "object"
          },
          "maxItems": 4096,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "platform": {
          "additionalProperties": false,
          "properties": {
            "arch": {
              "enum": [
                "x86_64",
                "aarch64"
              ]
            }
          },
          "required": [
            "arch"
          ],
          "type": "object"
        },
        "publisher": {
          "$ref": "#/$defs/Publisher"
        },
        "root": {
          "$ref": "#/$defs/BootRoot"
        },
        "schema": {
          "const": "misa.boot/v1"
        },
        "uki": {
          "$ref": "#/$defs/Uki"
        },
        "unlock": {
          "$ref": "#/$defs/Unlock"
        }
      },
      "required": [
        "schema",
        "platform",
        "kernel",
        "initrd",
        "cmdline",
        "root",
        "unlock",
        "mounts",
        "init",
        "modules",
        "firmware",
        "publisher",
        "health"
      ],
      "type": "object"
    },
    "BootRoot": {
      "$comment": "Filesystem enum is a syntactic S0 vocabulary, not recovery qualification for any driver. S0 does not boot.",
      "additionalProperties": false,
      "properties": {
        "fstype": {
          "$ref": "#/$defs/FsType"
        },
        "mountFlags": {
          "$ref": "#/$defs/MountFlags"
        },
        "selector": {
          "$ref": "#/$defs/RootSelector"
        }
      },
      "required": [
        "selector",
        "fstype",
        "mountFlags"
      ],
      "type": "object"
    },
    "Cmdline": {
      "$comment": "Ordered kernel tokens. Semantic checks require exactly one misa.root=kind=value token (Ch12 H2), no misa.generation= token, and rendered byte length below kernel.cmdlineLimit including the appended generation token.",
      "additionalProperties": false,
      "properties": {
        "template": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[^\\s\u0000]+$(?![\\s\\S])",
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "template"
      ],
      "type": "object"
    },
    "Digest": {
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])",
      "type": "string"
    },
    "Feature": {
      "maxLength": 128,
      "minLength": 4,
      "pattern": "^[a-z][a-z0-9.-]*/v[1-9][0-9]*$(?![\\s\\S])",
      "type": "string"
    },
    "Features": {
      "$comment": "Set-like array: semantic validation additionally requires ascending ASCII key order and unique identity keys.",
      "items": {
        "$ref": "#/$defs/Feature"
      },
      "maxItems": 256,
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "FsType": {
      "enum": [
        "ext4",
        "btrfs",
        "xfs"
      ]
    },
    "Health": {
      "additionalProperties": false,
      "properties": {
        "bless": {
          "additionalProperties": false,
          "properties": {
            "requires": {
              "$comment": "Set-like array: semantic validation additionally requires ascending ASCII key order and unique identity keys.",
              "items": {
                "$ref": "#/$defs/HealthGate"
              },
              "maxItems": 4,
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "requires"
          ],
          "type": "object"
        },
        "blessTimeoutSec": {
          "maximum": 86400,
          "minimum": 1,
          "type": "integer"
        },
        "gates": {
          "$comment": "Set-like array: semantic validation additionally requires ascending ASCII key order and unique identity keys.",
          "items": {
            "$ref": "#/$defs/HealthGate"
          },
          "maxItems": 4,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "gates",
        "bless",
        "blessTimeoutSec"
      ],
      "type": "object"
    },
    "HealthGate": {
      "enum": [
        "init-handoff",
        "base-target",
        "network",
        "user-session"
      ]
    },
    "KernelRelease": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$(?![\\s\\S])",
      "type": "string"
    },
    "KeyRef": {
      "$comment": "Ch16 KeyRef concretization: non-secret Ed25519 public key, canonical padded RFC4648 base64 of exactly 32 bytes; S0 does not verify signatures.",
      "additionalProperties": false,
      "properties": {
        "alg": {
          "const": "ed25519"
        },
        "keyId": {
          "$ref": "#/$defs/AsciiId"
        },
        "publicKey": {
          "maxLength": 44,
          "minLength": 44,
          "pattern": "^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$(?![\\s\\S])",
          "type": "string"
        }
      },
      "required": [
        "keyId",
        "alg",
        "publicKey"
      ],
      "type": "object"
    },
    "MachineBinding": {
      "maxLength": 32,
      "minLength": 32,
      "pattern": "^[0-9a-f]{32}$(?![\\s\\S])",
      "type": "string"
    },
    "MountFlags": {
      "$comment": "Set-like array: semantic validation additionally requires ascending ASCII key order and unique identity keys.",
      "items": {
        "enum": [
          "ro",
          "rw",
          "nodev",
          "nosuid",
          "noexec",
          "noatime",
          "relatime",
          "sync"
        ]
      },
      "maxItems": 8,
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "Path": {
      "$comment": "Canonical absolute UTF-8 lexical path. Symlink, mount and object-identity checks are outside S0. No Unicode normalization.",
      "maxLength": 4096,
      "minLength": 1,
      "not": {
        "pattern": "(?:^|/)\\.{1,2}(?:/|$)"
      },
      "pattern": "^/(?:[^/\u0000]+(?:/[^/\u0000]+)*)?$(?![\\s\\S])",
      "type": "string"
    },
    "Publisher": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "tries": {
                "const": 0
              }
            }
          },
          "if": {
            "properties": {
              "selection": {
                "const": "counting"
              }
            },
            "required": [
              "selection"
            ]
          },
          "then": {
            "properties": {
              "tries": {
                "maximum": 99,
                "minimum": 1,
                "type": "integer"
              }
            }
          }
        }
      ],
      "properties": {
        "rescue": {
          "type": "boolean"
        },
        "selection": {
          "enum": [
            "counting",
            "oneshot",
            "manual"
          ]
        },
        "sortKey": {
          "$ref": "#/$defs/AsciiId"
        },
        "titleKey": {
          "$ref": "#/$defs/AsciiId"
        },
        "tries": {
          "maximum": 99,
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "enum": [
            "bls1",
            "uki"
          ]
        }
      },
      "required": [
        "type",
        "titleKey",
        "sortKey",
        "rescue",
        "selection",
        "tries"
      ],
      "type": "object"
    },
    "RootSelector": {
      "$comment": "Ch11 RootId and Ch12 selector concretization: lowercase persistent UUIDs, not /dev names or unauthenticated labels.",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "partuuid",
            "fsuuid",
            "luksuuid"
          ]
        },
        "value": {
          "$ref": "#/$defs/Uuid"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "type": "object"
    },
    "StoreFile": {
      "$comment": "A store output or descendant; lexical syntax is not a closure or artifact verification.",
      "allOf": [
        {
          "$ref": "#/$defs/Path"
        },
        {
          "pattern": "^/nix/store/[0123456789abcdfghijklmnpqrsvwxyz]{32}-[A-Za-z0-9+._?=-]{1,211}(?:/[^/]+)*$(?![\\s\\S])"
        }
      ]
    },
    "U64": {
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^(?:0|[1-9][0-9]{0,18}|18446744073709551615|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4][0-9]{0})$(?![\\s\\S])",
      "type": "string"
    },
    "Uki": {
      "$comment": "Ch12 UKI concretization: profile IDs are numeric, ordered ascending; each profile declares its command-line template and rescue role. signerPolicy is an immutable policy digest plus explicit public-key threshold. No derived UKI digest, ESP path, publication sequence or signing secret enters the generation body.",
      "additionalProperties": false,
      "properties": {
        "profiles": {
          "$comment": "Set-like array: semantic validation additionally requires ascending ASCII key order and unique identity keys.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "cmdline": {
                "$ref": "#/$defs/Cmdline"
              },
              "id": {
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "rescue": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "rescue",
              "cmdline"
            ],
            "type": "object"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "recipeDigest": {
          "$ref": "#/$defs/Digest"
        },
        "signerPolicy": {
          "additionalProperties": false,
          "properties": {
            "keys": {
              "$comment": "Set-like array: semantic validation additionally requires ascending ASCII key order and unique identity keys.",
              "items": {
                "$ref": "#/$defs/KeyRef"
              },
              "maxItems": 64,
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "policyDigest": {
              "$ref": "#/$defs/Digest"
            },
            "threshold": {
              "maximum": 64,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "policyDigest",
            "keys",
            "threshold"
          ],
          "type": "object"
        }
      },
      "required": [
        "recipeDigest",
        "profiles",
        "signerPolicy"
      ],
      "type": "object"
    },
    "Unlock": {
      "$comment": "Ch12 concretization: none has explicit null identifiers and zero retry/timeout values. keyfile additionally identifies a non-secret path, not key bytes. allowDiscards is explicit, never implicitly enabled.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "allowDiscards": {
              "const": false
            },
            "luksUuid": {
              "type": "null"
            },
            "mapperName": {
              "type": "null"
            },
            "method": {
              "const": "none"
            },
            "timeoutSec": {
              "const": 0
            },
            "tries": {
              "const": 0
            }
          },
          "required": [
            "method",
            "luksUuid",
            "mapperName",
            "tries",
            "timeoutSec",
            "allowDiscards"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "allowDiscards": {
              "type": "boolean"
            },
            "luksUuid": {
              "$ref": "#/$defs/Uuid"
            },
            "mapperName": {
              "$ref": "#/$defs/AsciiId"
            },
            "method": {
              "const": "passphrase"
            },
            "timeoutSec": {
              "maximum": 86400,
              "minimum": 1,
              "type": "integer"
            },
            "tries": {
              "maximum": 99,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "method",
            "luksUuid",
            "mapperName",
            "tries",
            "timeoutSec",
            "allowDiscards"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "allowDiscards": {
              "type": "boolean"
            },
            "keyFile": {
              "$ref": "#/$defs/Path"
            },
            "luksUuid": {
              "$ref": "#/$defs/Uuid"
            },
            "mapperName": {
              "$ref": "#/$defs/AsciiId"
            },
            "method": {
              "const": "keyfile"
            },
            "timeoutSec": {
              "maximum": 86400,
              "minimum": 1,
              "type": "integer"
            },
            "tries": {
              "maximum": 99,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "method",
            "luksUuid",
            "mapperName",
            "tries",
            "timeoutSec",
            "allowDiscards",
            "keyFile"
          ],
          "type": "object"
        }
      ]
    },
    "Uuid": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])",
      "type": "string"
    }
  },
  "$id": "https://github.com/ZacharySF/misaos/schemas/misa.generation-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapterIdentity": {
      "$ref": "#/$defs/Digest"
    },
    "boot": {
      "$ref": "#/$defs/BootRecord"
    },
    "generationId": {
      "$ref": "#/$defs/Digest"
    },
    "machineId": {
      "$ref": "#/$defs/MachineBinding"
    },
    "planDigest": {
      "$ref": "#/$defs/Digest"
    },
    "requiredFeatures": {
      "$ref": "#/$defs/Features"
    },
    "roots": {
      "$comment": "Set-like array: semantic validation additionally requires ascending ASCII key order and unique identity keys.",
      "items": {
        "$ref": "#/$defs/Digest"
      },
      "maxItems": 4096,
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "schemaVersion": {
      "const": "misa.generation/v1"
    }
  },
  "required": [
    "schemaVersion",
    "machineId",
    "planDigest",
    "boot",
    "roots",
    "adapterIdentity",
    "requiredFeatures",
    "generationId"
  ],
  "title": "Misa generation v1 (S0 schema and semantic validation only)",
  "type": "object"
}
