{
  "$comment": "Generated by schemas/generate.py from architecture baseline 1.4 Ch11/12/16. Authority domains have independent exact discriminators. Unknown properties fail closed. S0 supports no requiredFeatures and provides no boot, signature, image, or execution proof.",
  "$defs": {
    "Annotations": {
      "additionalProperties": {
        "maxLength": 2048,
        "minLength": 0,
        "type": "string"
      },
      "maxProperties": 64,
      "propertyNames": {
        "$ref": "#/$defs/AsciiId"
      },
      "type": "object"
    },
    "Argv": {
      "items": {
        "$ref": "#/$defs/Text"
      },
      "maxItems": 256,
      "minItems": 0,
      "type": "array"
    },
    "AsciiId": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9.-]*$(?![\\s\\S])",
      "type": "string"
    },
    "Desktop": {
      "$comment": "Ch15 desktop metadata concretized for declarative ExportSpec; this is not the runtime ExportRecord or resolved ExecSpec.",
      "additionalProperties": false,
      "properties": {
        "dbusName": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "maxLength": 255,
              "minLength": 3,
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(?:\\.[A-Za-z_][A-Za-z0-9_-]*)+$(?![\\s\\S])",
              "type": "string"
            }
          ]
        },
        "entryDigest": {
          "$ref": "#/$defs/Digest"
        },
        "icons": {
          "$comment": "Set-like array: semantic validation additionally requires ascending ASCII key order and unique identity keys.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "digest": {
                "$ref": "#/$defs/Digest"
              },
              "path": {
                "$ref": "#/$defs/Path"
              }
            },
            "required": [
              "path",
              "digest"
            ],
            "type": "object"
          },
          "maxItems": 4096,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*\\.desktop$(?![\\s\\S])",
          "type": "string"
        },
        "mime": {
          "$comment": "Set-like array: semantic validation additionally requires ascending ASCII key order and unique identity keys.",
          "items": {
            "maxLength": 255,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9.+_-]+/[A-Za-z0-9.+_-]+$(?![\\s\\S])",
            "type": "string"
          },
          "maxItems": 4096,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "entryDigest",
        "icons",
        "mime",
        "dbusName"
      ],
      "type": "object"
    },
    "Digest": {
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])",
      "type": "string"
    },
    "EnvName": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$(?![\\s\\S])",
      "type": "string"
    },
    "ExportSpec": {
      "$comment": "Ch11 ExportSpec concretization: id is the plan-local key; name is a host CLI name; root is an OCI manifest digest. grants references hostGrants IDs. Full-host v1 has no hostGrants and therefore requires empty grants. argv is ordered and never shell-expanded.",
      "additionalProperties": false,
      "properties": {
        "argv": {
          "$ref": "#/$defs/Argv"
        },
        "desktop": {
          "$ref": "#/$defs/Desktop"
        },
        "env": {
          "$ref": "#/$defs/LiteralEnv"
        },
        "grants": {
          "$ref": "#/$defs/Ids"
        },
        "id": {
          "$ref": "#/$defs/AsciiId"
        },
        "name": {
          "$ref": "#/$defs/AsciiId"
        },
        "program": {
          "$ref": "#/$defs/Path"
        },
        "root": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "id",
        "name",
        "root",
        "program",
        "argv",
        "env",
        "grants"
      ],
      "type": "object"
    },
    "Feature": {
      "maxLength": 128,
      "minLength": 4,
      "pattern": "^[a-z][a-z0-9.-]*/v[1-9][0-9]*$(?![\\s\\S])",
      "type": "string"
    },
    "Features": {
      "$comment": "Set-like array: semantic validation additionally requires ascending ASCII key order and unique identity keys.",
      "items": {
        "$ref": "#/$defs/Feature"
      },
      "maxItems": 256,
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "ForeignStorage": {
      "$comment": "leased-gc has a complete wire form but S0 semantic validation rejects it with E_CAPABILITY: no qualified broker.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "retain-all"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "brokerPolicyDigest": {
              "$ref": "#/$defs/Digest"
            },
            "minRetainSeconds": {
              "$ref": "#/$defs/U64"
            },
            "mode": {
              "const": "leased-gc"
            }
          },
          "required": [
            "mode",
            "minRetainSeconds",
            "brokerPolicyDigest"
          ],
          "type": "object"
        }
      ]
    },
    "GrantSpec": {
      "$comment": "Ch11 narrow host-grant concretization. source is the host path, target the application-view path. Semantic checks reject reserved host destinations and writable overlaps. Session sockets are explicit endpoints, not arbitrary device or network grants.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/AsciiId"
            },
            "kind": {
              "const": "file"
            },
            "source": {
              "$ref": "#/$defs/Path"
            },
            "target": {
              "$ref": "#/$defs/Path"
            },
            "writable": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "kind",
            "source",
            "target",
            "writable"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/AsciiId"
            },
            "kind": {
              "const": "directory"
            },
            "source": {
              "$ref": "#/$defs/Path"
            },
            "target": {
              "$ref": "#/$defs/Path"
            },
            "writable": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "kind",
            "source",
            "target",
            "writable"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/AsciiId"
            },
            "kind": {
              "const": "session-socket"
            },
            "source": {
              "$ref": "#/$defs/Path"
            },
            "target": {
              "$ref": "#/$defs/Path"
            },
            "writable": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "kind",
            "source",
            "target",
            "writable"
          ],
          "type": "object"
        }
      ]
    },
    "Ids": {
      "$comment": "Set-like array: semantic validation additionally requires ascending ASCII key order and unique identity keys.",
      "items": {
        "$ref": "#/$defs/AsciiId"
      },
      "maxItems": 4096,
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "Inputs": {
      "additionalProperties": false,
      "properties": {
        "flakeLockDigest": {
          "$ref": "#/$defs/Digest"
        },
        "flakeSourceDigest": {
          "$ref": "#/$defs/Digest"
        },
        "foreignLockDigest": {
          "$ref": "#/$defs/Digest"
        },
        "misaLibraryDigest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "flakeSourceDigest",
        "flakeLockDigest",
        "foreignLockDigest",
        "misaLibraryDigest"
      ],
      "type": "object"
    },
    "KeyRef": {
      "$comment": "Ch16 KeyRef concretization: non-secret Ed25519 public key, canonical padded RFC4648 base64 of exactly 32 bytes; S0 does not verify signatures.",
      "additionalProperties": false,
      "properties": {
        "alg": {
          "const": "ed25519"
        },
        "keyId": {
          "$ref": "#/$defs/AsciiId"
        },
        "publicKey": {
          "maxLength": 44,
          "minLength": 44,
          "pattern": "^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$(?![\\s\\S])",
          "type": "string"
        }
      },
      "required": [
        "keyId",
        "alg",
        "publicKey"
      ],
      "type": "object"
    },
    "LiteralEnv": {
      "additionalProperties": {
        "$ref": "#/$defs/Text"
      },
      "maxProperties": 256,
      "propertyNames": {
        "$ref": "#/$defs/EnvName"
      },
      "type": "object"
    },
    "Path": {
      "$comment": "Canonical absolute UTF-8 lexical path. Symlink, mount and object-identity checks are outside S0. No Unicode normalization.",
      "maxLength": 4096,
      "minLength": 1,
      "not": {
        "pattern": "(?:^|/)\\.{1,2}(?:/|$)"
      },
      "pattern": "^/(?:[^/\u0000]+(?:/[^/\u0000]+)*)?$(?![\\s\\S])",
      "type": "string"
    },
    "PublisherKey": {
      "$comment": "Validity values are UTC Unix seconds. Ch16 publisher key IDs resolve through the root-owned key registry, not embedded private material. Semantic validation checks windows and rotation references.",
      "additionalProperties": false,
      "properties": {
        "alg": {
          "const": "ed25519"
        },
        "keyId": {
          "$ref": "#/$defs/AsciiId"
        },
        "revokedNotBefore": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "enum": [
            "active",
            "retiring",
            "revoked"
          ]
        },
        "successorOf": {
          "$ref": "#/$defs/AsciiId"
        },
        "validFrom": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "validUntil": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "keyId",
        "alg",
        "validFrom",
        "validUntil",
        "status"
      ],
      "type": "object"
    },
    "StoreOrOCIRef": {
      "$comment": "Ch11 tagged reference concretization: OCI layout plus manifest digest, or Nix store object holding an OCI layout; never a materialized-tree identity.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "store"
            },
            "path": {
              "$ref": "#/$defs/StorePath"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "oci"
            },
            "layout": {
              "$ref": "#/$defs/Path"
            },
            "manifest": {
              "$ref": "#/$defs/Digest"
            }
          },
          "required": [
            "kind",
            "layout",
            "manifest"
          ],
          "type": "object"
        }
      ]
    },
    "StorePath": {
      "allOf": [
        {
          "$ref": "#/$defs/Path"
        },
        {
          "pattern": "^/nix/store/[0123456789abcdfghijklmnpqrsvwxyz]{32}-[A-Za-z0-9+._?=-]{1,211}$(?![\\s\\S])"
        }
      ]
    },
    "Text": {
      "maxLength": 4096,
      "minLength": 0,
      "pattern": "^[^\u0000]*$(?![\\s\\S])",
      "type": "string"
    },
    "TrustPolicy": {
      "$comment": "Ch16 proposed policy layout, closed. Threshold roles are concretized as root/targets/snapshot/timestamp; interactive approval has zero cryptographic threshold and no keys. Policy consistency is validated, not authenticity, freshness, enrollment, or approval.",
      "additionalProperties": false,
      "properties": {
        "approvers": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "keys": {
                  "items": {
                    "$ref": "#/$defs/KeyRef"
                  },
                  "maxItems": 0,
                  "type": "array"
                },
                "mode": {
                  "const": "interactive"
                },
                "threshold": {
                  "const": 0
                }
              },
              "required": [
                "mode",
                "threshold",
                "keys"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "keys": {
                  "$comment": "Set-like array: semantic validation additionally requires ascending ASCII key order and unique identity keys.",
                  "items": {
                    "$ref": "#/$defs/KeyRef"
                  },
                  "maxItems": 64,
                  "minItems": 1,
                  "type": "array",
                  "uniqueItems": true
                },
                "mode": {
                  "const": "signed-by"
                },
                "threshold": {
                  "maximum": 64,
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "mode",
                "threshold",
                "keys"
              ],
              "type": "object"
            }
          ]
        },
        "channel": {
          "additionalProperties": false,
          "properties": {
            "rootDigest": {
              "$ref": "#/$defs/Digest"
            },
            "rootVersion": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "thresholds": {
              "additionalProperties": false,
              "properties": {
                "root": {
                  "maximum": 64,
                  "minimum": 1,
                  "type": "integer"
                },
                "snapshot": {
                  "maximum": 64,
                  "minimum": 1,
                  "type": "integer"
                },
                "targets": {
                  "maximum": 64,
                  "minimum": 1,
                  "type": "integer"
                },
                "timestamp": {
                  "maximum": 64,
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "root",
                "targets",
                "snapshot",
                "timestamp"
              ],
              "type": "object"
            }
          },
          "required": [
            "rootVersion",
            "rootDigest",
            "thresholds"
          ],
          "type": "object"
        },
        "epoch": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "imagePublishers": {
          "additionalProperties": {
            "$comment": "Set-like array: semantic validation additionally requires ascending ASCII key order and unique identity keys.",
            "items": {
              "$ref": "#/$defs/PublisherKey"
            },
            "maxItems": 64,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "maxProperties": 256,
          "propertyNames": {
            "$ref": "#/$defs/AsciiId"
          },
          "type": "object"
        },
        "nixSubstituters": {
          "$comment": "Set-like array: semantic validation additionally requires ascending ASCII key order and unique identity keys.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "publicKeys": {
                "$comment": "Set-like array: semantic validation additionally requires ascending ASCII key order and unique identity keys.",
                "items": {
                  "$ref": "#/$defs/KeyRef"
                },
                "maxItems": 64,
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "requireSigs": {
                "const": true
              },
              "url": {
                "maxLength": 2048,
                "minLength": 9,
                "pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]{1,5})?(?:/[^\\s?#]*)?$(?![\\s\\S])",
                "type": "string"
              }
            },
            "required": [
              "url",
              "publicKeys",
              "requireSigs"
            ],
            "type": "object"
          },
          "maxItems": 64,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "repoKeys": {
          "additionalProperties": {
            "$comment": "Set-like array: semantic validation additionally requires ascending ASCII key order and unique identity keys.",
            "items": {
              "$ref": "#/$defs/KeyRef"
            },
            "maxItems": 64,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "maxProperties": 256,
          "propertyNames": {
            "maxLength": 129,
            "minLength": 3,
            "pattern": "^[a-z][a-z0-9.-]*:[a-z][a-z0-9.-]*$(?![\\s\\S])",
            "type": "string"
          },
          "type": "object"
        },
        "time": {
          "additionalProperties": false,
          "properties": {
            "floorEpoch": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "source": {
              "const": "rtc+bounded-ntp"
            }
          },
          "required": [
            "source",
            "floorEpoch"
          ],
          "type": "object"
        }
      },
      "required": [
        "epoch",
        "nixSubstituters",
        "imagePublishers",
        "repoKeys",
        "channel",
        "approvers",
        "time"
      ],
      "type": "object"
    },
    "U64": {
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^(?:0|[1-9][0-9]{0,18}|18446744073709551615|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4][0-9]{0})$(?![\\s\\S])",
      "type": "string"
    },
    "VerifiedRootRef": {
      "additionalProperties": false,
      "properties": {
        "composeReceiptDigest": {
          "$ref": "#/$defs/Digest"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "libcFamily": {
          "enum": [
            "glibc",
            "musl"
          ]
        },
        "name": {
          "$ref": "#/$defs/AsciiId"
        },
        "platform": {
          "enum": [
            "linux/amd64",
            "linux/arm64",
            "linux/386"
          ]
        },
        "qualification": {
          "const": "R1"
        },
        "sealedPath": {
          "$ref": "#/$defs/StoreOrOCIRef"
        },
        "sourceLockKey": {
          "$ref": "#/$defs/AsciiId"
        }
      },
      "required": [
        "name",
        "platform",
        "libcFamily",
        "digest",
        "sourceLockKey",
        "sealedPath",
        "composeReceiptDigest",
        "qualification"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/ZacharySF/misaos/schemas/misa.strata-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "annotations": {
      "$ref": "#/$defs/Annotations"
    },
    "exports": {
      "$comment": "Set-like array: semantic validation additionally requires ascending ASCII key order and unique identity keys.",
      "items": {
        "$ref": "#/$defs/ExportSpec"
      },
      "maxItems": 4096,
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "foreignStorage": {
      "$ref": "#/$defs/ForeignStorage"
    },
    "hostGrants": {
      "$comment": "Set-like array: semantic validation additionally requires ascending ASCII key order and unique identity keys.",
      "items": {
        "$ref": "#/$defs/GrantSpec"
      },
      "maxItems": 4096,
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "hostId": {
      "$ref": "#/$defs/AsciiId"
    },
    "inputs": {
      "$ref": "#/$defs/Inputs"
    },
    "requiredFeatures": {
      "$ref": "#/$defs/Features"
    },
    "roots": {
      "$comment": "Set-like array: semantic validation additionally requires ascending ASCII key order and unique identity keys.",
      "items": {
        "$ref": "#/$defs/VerifiedRootRef"
      },
      "maxItems": 4096,
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "schemaVersion": {
      "const": "misa.strata/v1"
    },
    "trust": {
      "$ref": "#/$defs/TrustPolicy"
    }
  },
  "required": [
    "schemaVersion",
    "hostId",
    "inputs",
    "roots",
    "exports",
    "foreignStorage",
    "trust",
    "requiredFeatures",
    "hostGrants"
  ],
  "title": "Misa strata v1 (S0 schema and semantic validation only)",
  "type": "object"
}
